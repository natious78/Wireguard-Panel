{
  "name": "wireguard-control",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted MikroTik WireGuard peer management platform",
  "scripts": {
    "dev": "next dev -p 2040",
    "build": "next build",
    "start": "next start -p 2040",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:init-admin": "tsx scripts/init-admin.ts",
    "db:rotate-key": "tsx scripts/rotate-encryption-key.ts",
    "worker": "tsx scripts/worker.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "unrs-resolver"]
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "15.5.21",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tweetnacl": "^1.0.3",
    "undici": "^7.16.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/eslint-plugin-next": "15.5.21",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.21",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "sharp": "^0.34.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
