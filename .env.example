# Public URL and runtime
NODE_ENV=production
# Replace localhost with the server's LAN address when other devices will connect.
APP_URL=http://localhost:2040
PORT=2040

# PostgreSQL (change both values before deployment)
POSTGRES_DB=wireguard_control
POSTGRES_USER=wireguard_control
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Compose passes the fields separately, so the password does not need URL encoding.
# Standalone deployments may set DATABASE_URL instead.

# First-start administrator. The password is hashed and never persisted in plaintext.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Exactly 32 random bytes encoded as base64. Example: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Session and worker settings
SESSION_TTL_HOURS=12
SYNC_INTERVAL_SECONDS=300
MIKROTIK_STATS_INTERVAL=30
ROUTER_HEALTH_INTERVAL_SECONDS=60
BANDWIDTH_INTERVAL_SECONDS=300
OPERATION_RECONCILIATION_INTERVAL_SECONDS=60
TRAFFIC_AGGREGATION_INTERVAL_SECONDS=3600
MAINTENANCE_INTERVAL_SECONDS=21600
RAW_TRAFFIC_SAMPLE_SECONDS=300
AUDIT_RETENTION_DAYS=180
LOG_LEVEL=info
HEALTH_WORKER_STALE_SECONDS=900
STORAGE_WARNING_PERCENT=80
STORAGE_CRITICAL_PERCENT=90
# Writable container path used for storage-capacity reporting. Mount persistent data here.
PERSISTENT_DATA_PATH=/data
EXPIRATION_INTERVAL_SECONDS=60
ROUTER_CONNECT_TIMEOUT_MS=8000
ONLINE_THRESHOLD_SECONDS=180
RECENT_THRESHOLD_SECONDS=900

# Explicit opt-in only. Never enable this on production systems.
DEMO_MODE=false
